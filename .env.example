# OpenAI (read directly by the OpenAI SDK)
OPENAI_API_KEY=sk-...

# Models: bulk = high-volume structured work, agent = Q&A + reports
LEDGER_MODEL_BULK=gpt-5.4-mini
LEDGER_MODEL_AGENT=gpt-5.4
LEDGER_REASONING_EFFORT_BULK=low
LEDGER_REASONING_EFFORT_AGENT=medium

# Optional: $ tracking (copy current prices from the provider's pricing page)
# LEDGER_PRICE_INPUT_PER_MTOK=
# LEDGER_PRICE_OUTPUT_PER_MTOK=

LEDGER_DB_PATH=data/ledger.db
LEDGER_AUTO_ACCEPT_CONFIDENCE=0.80
LEDGER_MAX_TOKENS_PER_RUN=400000
# LEDGER_API_KEY=change-me          # require `Authorization: Bearer <key>` on the HTTP API
# LEDGER_LOG_FORMAT=json
